# Removed detector arguments must fail before any file or camera is opened.
foreach(binary_var IN ITEMS DEMO_AIM_BINARY VIDEO_WORKER_BINARY MEMORY_PROBE_BINARY)
  if(NOT DEFINED ${binary_var} OR NOT EXISTS "${${binary_var}}")
    message(FATAL_ERROR "Set ${binary_var} to the corresponding built executable")
  endif()
endforeach()

function(expect_help_without_detector binary)
  execute_process(COMMAND "${binary}" --help
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "--help failed for ${binary} (${result}): ${error}")
  endif()
  string(TOLOWER "${output}${error}" help_text)
  if(help_text MATCHES "yolo|onnx|--weights|--num-classes|--input-size")
    message(FATAL_ERROR "--help advertises a removed detector for ${binary}: ${help_text}")
  endif()
endfunction()

function(expect_rejected binary expected_error)
  execute_process(COMMAND "${binary}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(NOT result STREQUAL "1")
    message(FATAL_ERROR "Expected rejection for ${binary} ${ARGN}, got ${result}: ${output}${error}")
  endif()
  string(FIND "${output}${error}" "${expected_error}" error_position)
  if(error_position EQUAL -1)
    message(FATAL_ERROR "Wrong rejection for ${binary} ${ARGN}; expected '${expected_error}': ${output}${error}")
  endif()
endfunction()

foreach(binary IN ITEMS "${DEMO_AIM_BINARY}" "${VIDEO_WORKER_BINARY}" "${MEMORY_PROBE_BINARY}")
  expect_help_without_detector("${binary}")
  foreach(option IN ITEMS --weights --num-classes --input-size)
    if("${binary}" STREQUAL "${DEMO_AIM_BINARY}")
      set(expected "Unknown argument: ${option}")
    else()
      set(expected "Unknown option: ${option}")
    endif()
    expect_rejected("${binary}" "${expected}" "${option}" unused)
  endforeach()
endforeach()
foreach(binary IN ITEMS "${VIDEO_WORKER_BINARY}" "${MEMORY_PROBE_BINARY}")
  expect_rejected("${binary}" "--mode must be traditional" --mode yolo)
endforeach()
